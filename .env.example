# Klucz AES-256-GCM do szyfrowania danych w bazie (base64, 32 bajty).
# Wygeneruj: cargo run -- gen-key
ASI_DATA_KEY=

# Hasło konta "admin" tworzonego przy pierwszym starcie. Puste: hasło zostanie wygenerowane i wypisane w logu.
ASI_ADMIN_PASSWORD=

# Token API DefectDojo (nazwę zmiennej ustawia defectdojo.token_env w config/asi.toml).
ASI_DD_TOKEN=

# Nadpisanie adresu nasłuchu (np. w kontenerze).
# ASI_BIND=0.0.0.0:8080

RUST_LOG=info,sqlx=warn
