# Hasło konta "admin" tworzonego przy pierwszym starcie. Minimum 10 znaków.
ASI_ADMIN_PASSWORD=
# Hasło PostgreSQL w adresie URL, np. wygenerowane przez openssl rand -hex 32.
ASI_DB_PASSWORD=

# Opcjonalna integracja DefectDojo dla backendu PostgreSQL.
ASI_DD_URL=
ASI_DD_ENGAGEMENT=
ASI_DD_TOKEN=

# Nadpisanie adresu nasłuchu (np. w kontenerze).
# ASI_BIND=0.0.0.0:8080

RUST_LOG=info,sqlx=warn
